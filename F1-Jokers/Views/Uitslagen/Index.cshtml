@model F1Jokers.Models.UitslagViewModel

@{
    ViewData["Title"] = "Officiële Uitslagen";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-5 text-white fw-bold text-uppercase" style="letter-spacing: 1px;">
            <i class="bi bi-flag-fill text-danger me-2"></i> Officiële Uitslagen
        </h1>
        <p class="text-light opacity-75 mb-4">Bekijk hier de daadwerkelijke uitslagen waarop de poule-punten zijn berekend.</p>

        <div class="mb-4">
            <form method="get" action="/Uitslagen/Index">
                <label for="raceIdSelector" class="visually-hidden">Kies een Grand Prix</label>
                <select id="raceIdSelector" name="raceId" class="form-select bg-dark text-white border-secondary w-auto d-inline-block shadow-sm" onchange="this.form.submit()">
                    @if (Model.VolledigeKalender != null)
                    {
                        foreach (var item in Model.VolledigeKalender)
                        {
                            <option value="@item.RaceID" selected="@(item.RaceID == Model.SelectedRaceId)">
                                @item.Racenaam @(item.IsVerwerkt ? " (Verwerkt)" : "")
                            </option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>

    @if (Model.HuidigeKalenderItem != null && !Model.HuidigeKalenderItem.IsVerwerkt)
    {
        <div class="alert alert-warning text-center border-warning fw-bold max-w-75 mx-auto">
            <i class="bi bi-hourglass-split"></i> De officiële uitslagen voor deze race zijn nog niet opgehaald door de beheerder.
        </div>
    }
    else if (Model.HuidigeKalenderItem != null)
    {
        <div class="row justify-content-center gap-4">

            <div class="col-lg-5 column">
                <h2 class="column-title border-bottom border-danger pb-2 mb-3">Hoofdrace Uitslag</h2>

                <div class="bg-dark border border-secondary rounded p-3 mb-4">
                    <div class="scrollable-results">
                        <ul class="list-unstyled mb-0">
                            @foreach (var coureur in Model.RaceTop10)
                            {
                                <li class="d-flex align-items-center border-bottom border-secondary py-2">
                                    <span class="bg-danger text-white fw-bold text-center rounded px-2 py-1 me-3" style="min-width: 35px;">@coureur.Positie</span>
                                    <span class="text-danger fw-bold me-3" style="width: 25px;">@coureur.Startnr</span>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-white">@coureur.Naam</div>
                                        <div class="small text-light opacity-75">@coureur.Team</div>
                                    </div>
                                </li>
                            }
                            @if (!Model.RaceTop10.Any())
                            {
                                <li class="text-muted text-center py-2">Geen data gevonden...</li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="bonus-section p-3 border border-secondary rounded bg-dark">
                    <h3 class="h6 text-white text-uppercase border-bottom border-secondary pb-2 mb-3">Race Extra</h3>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-danger fw-bold small">Pole Position</span>
                        <span class="text-white fw-bold">
                            @if (Model.RacePole != null)
                            {
                                <span class="text-danger me-1">@Model.RacePole.Startnr</span> 
                                @Model.RacePole.Naam
                            }
                            else
                            {

                                @("-")
                            }
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-danger fw-bold small">Snelste Ronde</span>
                        <span class="text-white fw-bold">
                            @if (Model.SnelsteRonde != null)
                            {
                                <span class="text-danger me-1">@Model.SnelsteRonde.Startnr</span> 
                                @Model.SnelsteRonde.Naam
                            }
                            else
                            {

                                @("-")
                            }
                        </span>
                    </div>
                </div>
            </div>

            @if (Model.HuidigeKalenderItem.HasSprintRace)
            {
                <div class="col-lg-5 column">
                    <h2 class="column-title border-bottom border-danger pb-2 mb-3">Sprintrace Uitslag</h2>

                    <div class="bg-dark border border-secondary rounded p-3 mb-4">
                        <div class="scrollable-results">
                            <ul class="list-unstyled mb-0">
                                @foreach (var coureur in Model.SprintTop5)
                                {
                                    <li class="d-flex align-items-center border-bottom border-secondary py-2">
                                        <span class="bg-danger text-white fw-bold text-center rounded px-2 py-1 me-3" style="min-width: 35px;">@coureur.Positie</span>
                                        <span class="text-danger fw-bold me-3" style="width: 25px;">@coureur.Startnr</span>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-white">@coureur.Naam</div>
                                            <div class="small text-light opacity-75">@coureur.Team</div>
                                        </div>
                                    </li>
                                }
                                @if (!Model.SprintTop5.Any())
                                {
                                    <li class="text-muted text-center py-2">Geen data gevonden...</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="bonus-section p-3 border border-secondary rounded bg-dark">
                        <h3 class="h6 text-white text-uppercase border-bottom border-secondary pb-2 mb-3">Sprint Extra</h3>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-danger fw-bold small">Sprint Pole</span>
                            <span class="text-white fw-bold">
                                @if (Model.SprintPole != null)
                                {
                                    <span class="text-danger me-1">@Model.SprintPole.Startnr</span> 
                                    @Model.SprintPole.Naam
                                }
                                else
                                {

                                    @("-")
                                }
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>