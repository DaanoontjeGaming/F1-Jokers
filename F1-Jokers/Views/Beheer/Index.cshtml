@{
    ViewData["Title"] = "Controlepaneel";
}

<div class="mt-4">
    <h1 class="text-danger"><i class="bi bi-gear-wide-connected"></i> Beheerder Controlepaneel</h1>
    <p class="lead">Welkom terug, @User.Identity?.Name. Hier kun je de race-instellingen en gebruikers beheren.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card bg-secondary text-white border-secondary mb-3">
                <div class="card-body text-center">
                    <i class="bi bi-flag-fill fs-1"></i>
                    <h5 class="card-title mt-2">Uitslagen Invullen</h5>
                    <p class="card-text small">Voer de officiële uitslagen van de laatste race in.</p>
                    <button class="btn btn-danger btn-sm">Openen</button>
                </div>
            </div>
        </div>
    </div>
</div>