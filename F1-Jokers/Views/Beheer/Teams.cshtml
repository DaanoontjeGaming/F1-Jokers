@model IEnumerable<F1Jokers.Models.Team>

@{
    ViewData["Title"] = "Teams Beheren";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-white fw-bold text-uppercase mb-0"><i class="bi bi-car-front-fill text-danger me-2"></i> Teams Beheer</h1>
            <p class="text-light opacity-75 mt-1">Voeg nieuwe F1 teams toe, bewerk gegevens of verwijder inactieve renstallen.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Terug naar Paneel</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show text-center border-danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-header border-secondary bg-black d-flex justify-content-between align-items-center p-3">
            <h5 class="mb-0 text-white fw-bold"><i class="bi bi-list-ul text-danger me-2"></i> Alle F1 Teams</h5>
            <button type="button" class="btn btn-sm btn-danger fw-bold" data-bs-toggle="modal" data-bs-target="#voegTeamToeModal">
                <i class="bi bi-plus-lg"></i> Team Toevoegen
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th class="ps-4">Team ID</th>
                            <th>Teamnaam</th>
                            <th>Powerunit (Motor)</th>
                            <th>Punten</th>
                            <th class="text-end pe-4">Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-danger">@team.TeamId</td>
                                <td>@team.Teamnaam</td>
                                <td>@team.Powerunit</td>
                                <td>@team.TeamPoints</td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#bewerkModal-@team.TeamId" title="Bewerken">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <form asp-action="VerwijderTeam" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="teamId" value="@team.TeamId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Weet je zeker dat je team @team.Teamnaam wilt verwijderen? Dit kan alleen als er geen coureurs meer aan gekoppeld zijn.');" title="Verwijderen">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            <!-- MODAL: BEWERKEN -->
                            <div class="modal fade" id="bewerkModal-@team.TeamId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content bg-dark border-secondary text-white">
                                        <div class="modal-header border-secondary">
                                            <h5 class="modal-title fw-bold">Bewerk @team.Teamnaam</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="BewerkTeam" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="TeamId" value="@team.TeamId" />
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label text-danger small fw-bold">Teamnaam</label>
                                                    <input type="text" name="Teamnaam" class="form-control bg-dark text-white border-secondary" value="@team.Teamnaam" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-danger small fw-bold">Powerunit</label>
                                                    <input type="text" name="Powerunit" class="form-control bg-dark text-white border-secondary" value="@team.Powerunit" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-danger small fw-bold">Team Punten</label>
                                                    <input type="number" name="TeamPoints" class="form-control bg-dark text-white border-secondary" value="@team.TeamPoints" />
                                                </div>
                                            </div>
                                            <div class="modal-footer border-secondary">
                                                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Annuleren</button>
                                                <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="bi bi-save-fill me-1"></i> Opslaan</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: TOEVOEGEN -->
<div class="modal fade" id="voegTeamToeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-uppercase"><i class="bi bi-plus-square-fill text-danger me-2"></i> Nieuw Team</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="VoegTeamToe" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-danger small fw-bold">Teamnaam</label>
                        <input type="text" name="Teamnaam" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-danger small fw-bold">Powerunit</label>
                        <input type="text" name="Powerunit" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-danger small fw-bold">Start Punten (optioneel)</label>
                        <input type="number" name="TeamPoints" class="form-control bg-dark text-white border-secondary" value="0" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-danger fw-bold"><i class="bi bi-plus-lg me-1"></i> Toevoegen</button>
                </div>
            </form>
        </div>
    </div>
</div>