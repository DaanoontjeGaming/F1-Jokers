        <section class="column race-section hide-section" id="season-drivers" style="width: @(seasonLocked ? "530px" : "420px"); max-width: 100%;">
            @if (seasonLocked)
            {
                <div class="card bg-dark border-secondary p-3 mb-4 rounded-1 shadow-sm">
                    <h5 class="text-white fw-bold text-uppercase border-bottom border-danger pb-2 mb-3">Eindstand Coureurs</h5>
                    <div style="max-height: 480px; overflow-y: auto; overflow-x: hidden;" class="pe-2 custom-f1-scrollbar">
                        @for (int i = 1; i <= 22; i++)
                        {
                            var v = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == $"SeizoenCPos{i}");
