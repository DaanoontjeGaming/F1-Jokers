@model F1Jokers.Models.VoorspellingViewModel

@{
    var gesorteerdeCoureurs = Model.Coureurs?
        .OrderBy(c => c.Team != null ? c.Team.Teamnaam : "ZZZ")
        .ThenBy(c => c.Startnr)
        .ToList();

    var gesorteerdeTeams = gesorteerdeCoureurs?
        .Where(c => c.Team != null)
        .Select(c => c.Team)
        .GroupBy(t => t.Teamnaam)
        .Select(g => g.First())
        .OrderBy(t => t.Teamnaam)
        .ToList();
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="container py-5">
        <div class="text-center p-5 bg-dark border border-secondary rounded shadow" style="border-top: 5px solid var(--f1-red) !important;">
            <i class="bi bi-lock-fill text-danger display-1 mb-4"></i>
            <h1 class="text-white h2 fw-bold">TOEGANG GEWEIGERD</h1>
            <p class="text-light opacity-75 mb-4">Je moet ingelogd zijn om voorspellingen te doen.</p>
            <a asp-controller="Account" asp-action="Inloggen" class="btn btn-danger btn-lg px-5 fw-bold shadow">
                <i class="bi bi-box-arrow-in-right me-2"></i> INLOGGEN
            </a>
        </div>
    </div>
}
else
{
    <section class="race-info text-center mb-4">
        <div class="mb-4">
            <form method="get" action="/Voorspelling/Index">
                <select id="raceIdSelector" name="raceId" class="form-select bg-dark text-white border-secondary w-auto d-inline-block" onchange="this.form.submit()">
                    @if (Model.VolledigeKalender != null)
                    {
                        foreach (var item in Model.VolledigeKalender)
                        {
                            <option value="@item.RaceID" selected="@(Model.HuidigeKalenderItem != null && item.RaceID == Model.HuidigeKalenderItem.RaceID)">@item.Racenaam</option>
                        }
                    }
                </select>
            </form>
        </div>
        
        <div class="race-tabs btn-group mb-3">
            <button type="button" class="btn-tab active" onclick="switchView('main-race')">Hoofdrace</button>
            @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
            {
                <button type="button" class="btn-tab" onclick="switchView('sprint-race')">Sprintrace</button>
            }
            <button type="button" class="btn-tab btn-season" onclick="switchView('season-drivers')">Seizoen Coureurs</button>
            <button type="button" class="btn-tab btn-season" onclick="switchView('season-teams')">Seizoen Teams</button>
        </div>

        <div class="mb-4 d-none d-lg-block">
            <button type="button" id="btn-toggle-ui" class="btn btn-info fw-bold" onclick="toggleAccessibilityMode()">
                <i class="bi bi-universal-access"></i> Wissel naar Toegankelijk Voorspellen (Dropdowns)
            </button>
        </div>
    </section>

    <div id="voorspel-container" class="prediction-container d-flex gap-4 responsive-layout">
        
        <section class="column desktop-only flex-shrink-0" id="selection-pool" style="width: 350px;">
            <h2 class="column-title border-bottom border-danger pb-2 mb-3">Keuzelijst</h2>
            <div class="scrollable-pool">
                <ul class="driver-list mb-4 race-pool list-unstyled" id="pool-main" ondrop="drop(event)" ondragover="allowDrop(event)">
                    @foreach (var coureur in gesorteerdeCoureurs)
                    {
                        <li class="driver-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                            draggable="true" ondragstart="drag(event)" id="main-c-@coureur.Startnr" data-id="@coureur.Startnr">
                            <div>
                                <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; min-width: 25px;">@coureur.Startnr</span>
                                <span class="dr-name">@coureur.Voornaam @coureur.Achternaam</span>
                            </div>
                            <span class="dr-team small text-muted text-end">@(coureur.Team?.Teamnaam)</span>
                        </li>
                    }
                </ul>
                <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-sprint" ondrop="drop(event)" ondragover="allowDrop(event)">
                    @foreach (var coureur in gesorteerdeCoureurs)
                    {
                        <li class="driver-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                            draggable="true" ondragstart="drag(event)" id="sprint-c-@coureur.Startnr" data-id="@coureur.Startnr">
                            <div><span class="dr-number text-danger fw-bold me-3">@coureur.Startnr</span> @coureur.Voornaam @coureur.Achternaam</div>
                        </li>
                    }
                </ul>
                <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-season-drivers" ondrop="drop(event)" ondragover="allowDrop(event)">
                    @foreach (var coureur in gesorteerdeCoureurs)
                    {
                        <li class="driver-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                            draggable="true" ondragstart="drag(event)" id="sdriver-c-@coureur.Startnr" data-id="@coureur.Startnr">
                            <div><span class="dr-number text-danger fw-bold me-3">@coureur.Startnr</span> @coureur.Voornaam @coureur.Achternaam</div>
                        </li>
                    }
                </ul>
                <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-season-teams" ondrop="drop(event)" ondragover="allowDrop(event)">
                    @foreach (var team in gesorteerdeTeams)
                    {
                        <li class="team-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                            draggable="true" ondragstart="drag(event)" id="team-c-@team.TeamId" data-id="@team.TeamId">
                            <span class="dr-name fw-bold">@team.Teamnaam</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section class="column race-section flex-grow-1" id="main-race" style="min-width: 300px;">
            <h2 class="column-title border-bottom border-danger pb-2 mb-3">Top 10 (Race)</h2>
            <div class="drop-zones mb-4">
                @for (int i = 1; i <= 10; i++)
                {
                    <div class="slot d-flex mb-2 align-items-center">
                        <span class="pos-num bg-danger text-white px-3 py-2 fw-bold text-center" style="min-width: 40px;">@i</span>
                        <div class="drop-target border border-secondary p-2 flex-grow-1 ms-2 desktop-only" id="race-pos@(i)" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 40px;">...</div>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-main" id="mobile-race-pos@(i)">
                            <option value="">Kies...</option>
                            @foreach (var c in gesorteerdeCoureurs)
                            {
                                <option value="@c.Startnr">#@c.Startnr @c.Achternaam</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="bonus-section mt-4 p-3 border border-secondary rounded">
                <label for="bonus-pole" class="text-danger small fw-bold">Pole Position</label>
                <select class="form-select bg-dark text-white border-secondary mb-2" id="bonus-pole">
                    <option value="">Kies...</option>
                    @foreach (var c in gesorteerdeCoureurs)
                    {
                        <option value="@c.Startnr">#@c.Startnr @c.Achternaam</option>
                    }
                </select>
                <label for="bonus-fastest" class="text-danger small fw-bold">Snelste Ronde</label>
                <select class="form-select bg-dark text-white border-secondary" id="bonus-fastest">
                    <option value="">Kies...</option>
                    @foreach (var c in gesorteerdeCoureurs)
                    {
                        <option value="@c.Startnr">#@c.Startnr @c.Achternaam</option>
                    }
                </select>
            </div>
        </section>
        
        @* --- HIER KUN JE DE ANDERE SECTIES (SPRINT/SEIZOEN) TOEVOEGEN MET DEZELFDE id="...@(i)" LOGICA --- *@

    </div>

    <div class="text-center mt-5 mb-5">
        <button type="button" class="btn btn-lg btn-danger px-5 py-3 fw-bold shadow" onclick="verstuurVoorspelling()">
            VOORSPELLING OPSLAAN
        </button>
    </div>
}

@section Scripts {
    <script src="~/js/voorspellen.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dbData = @Html.Raw(Json.Serialize(Model.BestaandeVoorspellingen));
            if (!dbData || dbData.length === 0) return;

            dbData.forEach(v => {
                let typeV = (v.typeVoorspelling || v.TypeVoorspelling || "").trim();
                let dataId = v.startNr ?? v.StartNr ?? "";
                if (!typeV || dataId === "") return;

                // 1. Bonus velden
                const bonusMap = { "RacePole": "bonus-pole", "SnelsteRonde": "bonus-fastest", "SprintPole": "bonus-sprint-pole" };
                if (bonusMap[typeV]) { const el = document.getElementById(bonusMap[typeV]); if (el) el.value = dataId; return; }

                // 2. Drag & Drop Mapping
                let zoneId = "", poolId = "", mobId = "";
                if (typeV.includes("RacePos")) { let n = typeV.replace("RacePos", ""); zoneId = "race-pos" + n; poolId = "pool-main"; mobId = "mobile-race-pos" + n; }
                else if (typeV.includes("SprintPos")) { let n = typeV.replace("SprintPos", ""); zoneId = "sprint-pos" + n; poolId = "pool-sprint"; mobId = "mobile-sprint-pos" + n; }
                else if (typeV.includes("SeizoenCPos")) { let n = typeV.replace("SeizoenCPos", ""); zoneId = "sdriver-pos" + n; poolId = "pool-season-drivers"; mobId = "mobile-sdriver-pos" + n; }
                else if (typeV.includes("SeizoenTPos")) { let n = typeV.replace("SeizoenTPos", ""); zoneId = "steam-pos" + n; poolId = "pool-season-teams"; mobId = "mobile-steam-pos" + n; }

                if (zoneId && poolId) {
                    const dropZone = document.getElementById(zoneId);
                    const card = document.querySelector("#" + poolId + " li[data-id='" + dataId + "']");
                    if (dropZone && card) {
                        const clone = card.cloneNode(true);
                        clone.id = "clone-" + card.id + "-target-" + dropZone.id;
                        clone.setAttribute("ondragstart", "drag(event)");
                        clone.setAttribute("data-id", dataId);
                        dropZone.innerHTML = "";
                        dropZone.appendChild(clone);
                        card.classList.add("hide-section");
                    }
                }
                if (mobId) { const el = document.getElementById(mobId); if (el) el.value = dataId; }
            });
        });
    </script>
}