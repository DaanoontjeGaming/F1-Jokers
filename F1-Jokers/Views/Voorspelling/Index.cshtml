@model F1Jokers.Models.VoorspellingViewModel

@{
    var gesorteerdeCoureurs = Model.Coureurs?
        .OrderBy(c => c.Team != null ? c.Team.Teamnaam : "ZZZ")
        .ThenBy(c => c.Startnr)
        .ToList();

    var gesorteerdeTeams = gesorteerdeCoureurs?
        .Where(c => c.Team != null)
        .Select(c => c.Team)
        .GroupBy(t => t.Teamnaam)
        .Select(g => g.First())
        .OrderBy(t => t.Teamnaam)
        .ToList();
}

<section class="race-info text-center mb-4">
    <div class="mb-4">
        <form method="get" action="/Voorspelling/Index">
            <select id="raceIdSelector" name="raceId" class="form-select bg-dark text-white border-secondary w-auto d-inline-block" onchange="this.form.submit()">
                @if (Model.VolledigeKalender != null)
                {
                    foreach (var item in Model.VolledigeKalender)
                    {
                        if (Model.HuidigeKalenderItem != null && item.RaceID == Model.HuidigeKalenderItem.RaceID)
                        {
                            <option value="@item.RaceID" selected>@item.Racenaam</option>
                        }
                        else
                        {
                            <option value="@item.RaceID">@item.Racenaam</option>
                        }
                    }
                }
            </select>
        </form>
    </div>
    
    <div class="race-tabs btn-group mb-3">
        <button type="button" class="btn-tab active" onclick="switchView('main-race')">Hoofdrace</button>
        @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
        {
            <button type="button" class="btn-tab" onclick="switchView('sprint-race')">Sprintrace</button>
        }
        <button type="button" class="btn-tab btn-season" onclick="switchView('season-drivers')">Seizoen Coureurs</button>
        <button type="button" class="btn-tab btn-season" onclick="switchView('season-teams')">Seizoen Teams</button>
    </div>

    <div class="deadline-container mb-3">
        <div id="deadline-status" class="deadline-badge d-inline-block p-2 border border-danger text-danger fw-bold">
            <i class="bi bi-clock-fill"></i>
            <span id="deadline-text">
                @(Model.HuidigeKalenderItem != null ? "Deadline: " + Model.HuidigeKalenderItem.Deadline.ToString("dd MMMM yyyy - HH:mm", new System.Globalization.CultureInfo("nl-NL")) : "Geen data beschikbaar")
            </span>
        </div>
    </div>
</section>

<div class="prediction-container d-flex gap-4 responsive-layout">
    
    <section class="column desktop-only flex-shrink-0" id="selection-pool" style="width: 350px;">
        <h2 class="column-title border-bottom border-danger pb-2 mb-3">Keuzelijst</h2>
        
        <ul class="driver-list mb-4 race-pool list-unstyled" id="pool-main" ondrop="drop(event)" ondragover="allowDrop(event)">
            @if (gesorteerdeCoureurs != null)
            {
                foreach (var coureur in gesorteerdeCoureurs)
                {
                    <li class="driver-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                        draggable="true" ondragstart="drag(event)"
                        id="main-c-@coureur.Startnr" data-id="@coureur.Startnr">
                        <div>
                            <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; min-width: 25px;">@coureur.Startnr</span>
                            <span class="dr-name" style="display: inline-block; min-width: 150px;">@coureur.Voornaam @coureur.Achternaam</span>
                        </div>
                        <span class="dr-team small text-muted text-end">@(coureur.Team != null ? coureur.Team.Teamnaam : "")</span>
                    </li>
                }
            }
        </ul>

        @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
        {
            <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-sprint" ondrop="drop(event)" ondragover="allowDrop(event)">
                @if (gesorteerdeCoureurs != null)
                {
                    foreach (var coureur in gesorteerdeCoureurs)
                    {
                        <li class="driver-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                            draggable="true" ondragstart="drag(event)"
                            id="sprint-c-@coureur.Startnr" data-id="@coureur.Startnr">
                            <div>
                                <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; min-width: 25px;">@coureur.Startnr</span>
                                <span class="dr-name" style="display: inline-block; min-width: 150px;">@coureur.Voornaam @coureur.Achternaam</span>
                            </div>
                            <span class="dr-team small text-muted text-end">@(coureur.Team != null ? coureur.Team.Teamnaam : "")</span>
                        </li>
                    }
                }
            </ul>
        }

        <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-season-drivers" ondrop="drop(event)" ondragover="allowDrop(event)">
            @if (gesorteerdeCoureurs != null)
            {
                foreach (var coureur in gesorteerdeCoureurs)
                {
                    <li class="driver-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                        draggable="true" ondragstart="drag(event)"
                        id="sdriver-c-@coureur.Startnr" data-id="@coureur.Startnr">
                        <div>
                            <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; min-width: 25px;">@coureur.Startnr</span>
                            <span class="dr-name" style="display: inline-block; min-width: 150px;">@coureur.Voornaam @coureur.Achternaam</span>
                        </div>
                        <span class="dr-team small text-muted text-end">@(coureur.Team != null ? coureur.Team.Teamnaam : "")</span>
                    </li>
                }
            }
        </ul>

        <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-season-teams" ondrop="drop(event)" ondragover="allowDrop(event)">
            @if (gesorteerdeTeams != null)
            {
                foreach (var team in gesorteerdeTeams)
                {
                    <li class="team-card border border-secondary p-2 mb-2 d-flex justify-content-between align-items-center"
                        draggable="true" ondragstart="drag(event)"
                        id="team-c-@team.TeamId" data-id="@team.TeamId">
                        <div>
                            <span class="dr-name fw-bold" style="display: inline-block; min-width: 150px;">@team.Teamnaam</span>
                            <span class="t-pu small text-muted">@team.Powerunit</span>
                        </div>
                    </li>
                }
            }
        </ul>
    </section>

    <section class="column race-section flex-grow-1" id="main-race" style="min-width: 300px;">
        <h2 class="column-title border-bottom border-danger pb-2 mb-3">Top 10 (Race)</h2>
        <div class="drop-zones mb-4">
            @for (int i = 1; i <= 10; i++)
            {
                <div class="slot d-flex mb-2 align-items-center">
                    <span class="pos-num bg-danger text-white px-3 py-2 fw-bold text-center" style="min-width: 40px;">@i</span>
                    <div class="drop-target border border-secondary p-2 flex-grow-1 ms-2 desktop-only" id="race-pos@i" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 40px;">...</div>
                    <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-main" id="mobile-race-pos@i">
                        <option value="">Kies coureur...</option>
                        @if (gesorteerdeCoureurs != null)
                        {
                            foreach (var c in gesorteerdeCoureurs)
                            {
                                <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                            }
                        }
                    </select>
                </div>
            }
        </div>
        <div class="bonus-section mt-4 p-3 border border-secondary rounded">
            <h3 class="column-title h5 text-white">Race Extra</h3>
            <div class="mb-3">
                <label class="text-danger small fw-bold d-block mb-1">Pole Position</label>
                <select class="form-select bg-dark text-white border-secondary" id="bonus-pole">
                    <option value="">Kies coureur...</option>
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var c in gesorteerdeCoureurs)
                        {
                            <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-0">
                <label class="text-danger small fw-bold d-block mb-1">Snelste Ronde</label>
                <select class="form-select bg-dark text-white border-secondary" id="bonus-fastest">
                    <option value="">Kies coureur...</option>
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var c in gesorteerdeCoureurs)
                        {
                            <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                        }
                    }
                </select>
            </div>
        </div>
    </section>

    @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
    {
        <section class="column race-section hide-section flex-grow-1" id="sprint-race" style="min-width: 300px;">
            <h2 class="column-title border-bottom border-danger pb-2 mb-3">Top 5 (Sprint)</h2>
            <div class="drop-zones mb-4">
                @for (int i = 1; i <= 5; i++)
                {
                    <div class="slot d-flex mb-2 align-items-center">
                        <span class="pos-num bg-danger text-white px-3 py-2 fw-bold text-center" style="min-width: 40px;">@i</span>
                        <div class="drop-target border border-secondary p-2 flex-grow-1 ms-2 desktop-only" id="sprint-pos@i" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 40px;">...</div>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-sprint" id="mobile-sprint-pos@i">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                                }
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="bonus-section mt-4 p-3 border border-secondary rounded">
                <h3 class="column-title h5 text-white">Sprint Extra</h3>
                <div class="mb-0">
                    <label class="text-danger small fw-bold d-block mb-1">Sprint Pole</label>
                    <select class="form-select bg-dark text-white border-secondary" id="bonus-sprint-pole">
                        <option value="">Kies coureur...</option>
                        @if (gesorteerdeCoureurs != null)
                        {
                            foreach (var c in gesorteerdeCoureurs)
                            {
                                <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </section>
    }

    <section class="column race-section hide-section flex-grow-1" id="season-drivers" style="min-width: 300px;">
        <h2 class="column-title border-bottom border-danger pb-2 mb-3">Eindstand Coureurs (Top 22)</h2>
        <div class="drop-zones mb-4">
            @for (int i = 1; i <= 22; i++)
            {
                <div class="slot d-flex mb-2 align-items-center">
                    <span class="pos-num bg-danger text-white px-3 py-2 fw-bold text-center" style="min-width: 40px;">@i</span>
                    <div class="drop-target border border-secondary p-2 flex-grow-1 ms-2 desktop-only" id="sdriver-pos@i" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 40px;">...</div>
                    <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-sdrivers" id="mobile-sdriver-pos@i">
                        <option value="">Kies coureur...</option>
                        @if (gesorteerdeCoureurs != null)
                        {
                            foreach (var c in gesorteerdeCoureurs)
                            {
                                <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                            }
                        }
                    </select>
                </div>
            }
        </div>
    </section>

    <section class="column race-section hide-section flex-grow-1" id="season-teams" style="min-width: 300px;">
        <h2 class="column-title border-bottom border-danger pb-2 mb-3">Eindstand Teams (Top 11)</h2>
        <div class="drop-zones mb-4">
            @for (int i = 1; i <= 11; i++)
            {
                <div class="slot d-flex mb-2 align-items-center">
                    <span class="pos-num bg-danger text-white px-3 py-2 fw-bold text-center" style="min-width: 40px;">@i</span>
                    <div class="drop-target border border-secondary p-2 flex-grow-1 ms-2 desktop-only" id="steam-pos@i" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 40px;">...</div>
                    <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-steams" id="mobile-steam-pos@i">
                        <option value="">Kies team...</option>
                        @if (gesorteerdeTeams != null)
                        {
                            foreach (var t in gesorteerdeTeams)
                            {
                                <option value="@t.TeamId">@t.Teamnaam - @t.Powerunit</option>
                            }
                        }
                    </select>
                </div>
            }
        </div>

        <div class="bonus-section mt-4 p-3 border border-secondary rounded">
            <h3 class="column-title h5 text-white">Seizoen Extra</h3>
            <div class="mb-3">
                <label class="text-danger small fw-bold d-block mb-1">Meeste Race Overwinningen</label>
                <select class="form-select bg-dark text-white border-secondary" id="season-most-wins">
                    <option value="">Kies coureur...</option>
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var c in gesorteerdeCoureurs)
                        {
                            <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="text-danger small fw-bold d-block mb-1">Meeste Sprint Overwinningen</label>
                <select class="form-select bg-dark text-white border-secondary" id="season-most-sprint-wins">
                    <option value="">Kies coureur...</option>
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var c in gesorteerdeCoureurs)
                        {
                            <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="text-danger small fw-bold d-block mb-1">Meeste Race Poles</label>
                <select class="form-select bg-dark text-white border-secondary" id="season-most-poles">
                    <option value="">Kies coureur...</option>
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var c in gesorteerdeCoureurs)
                        {
                            <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-0">
                <label class="text-danger small fw-bold d-block mb-1">Meeste Sprint Poles</label>
                <select class="form-select bg-dark text-white border-secondary" id="season-most-sprint-poles">
                    <option value="">Kies coureur...</option>
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var c in gesorteerdeCoureurs)
                        {
                            <option value="@c.Startnr">@c.Startnr - @c.Voornaam @c.Achternaam @(c.Team != null ? " (" + c.Team.Teamnaam + ")" : "")</option>
                        }
                    }
                </select>
            </div>
        </div>
    </section>
</div>

<div class="text-center mt-5 mb-5">
    <button type="button" class="btn btn-lg btn-danger px-5 py-3 fw-bold shadow" onclick="verstuurVoorspelling()">
        VOORSPELLING OPSLAAN
    </button>
</div>

@section Scripts {
    <script>
        function allowDrop(ev) { ev.preventDefault(); }

        function drag(ev) { ev.dataTransfer.setData("text", ev.target.id); }

        function drop(ev) {
            ev.preventDefault();
            const data = ev.dataTransfer.getData("text");
            if (!data) return;
            
            const draggedElement = document.getElementById(data);
            const target = ev.target;
            const dropZone = target.closest(".drop-target");
            const pool = target.closest(".driver-list");

            if (!draggedElement) return;

            // Terugslepen naar lijst
            if (pool && data.startsWith("clone-")) {
                const originalId = data.replace("clone-", "").split("-target")[0];
                const originalElement = document.getElementById(originalId);
                if (originalElement) originalElement.classList.remove("hide-section");
                
                const parentZone = draggedElement.parentNode;
                parentZone.innerHTML = "...";
                draggedElement.remove();
                return;
            }

            // In een vakje slepen
            if (dropZone) {
                if (dropZone.children.length > 0 && dropZone.innerText !== "...") {
                    const existingClone = dropZone.children[0];
                    if (existingClone && existingClone.id && existingClone.id.startsWith("clone-")) {
                        const existingOriginalId = existingClone.id.replace("clone-", "").split("-target")[0];
                        const existingOriginal = document.getElementById(existingOriginalId);
                        if (existingOriginal) existingOriginal.classList.remove("hide-section");
                    }
                }

                if (data.startsWith("clone-")) {
                    dropZone.innerHTML = "";
                    dropZone.appendChild(draggedElement);
                } else {
                    const clone = draggedElement.cloneNode(true);
                    clone.id = "clone-" + data + "-target-" + dropZone.id;
                    clone.setAttribute("ondragstart", "drag(event)");

                    // Zorg ervoor dat data-id attribuut behouden blijft
                    const originalDataId = draggedElement.getAttribute('data-id');
                    if (originalDataId) {
                        clone.setAttribute('data-id', originalDataId);
                    }

                    dropZone.innerHTML = "";
                    dropZone.appendChild(clone);
                    draggedElement.classList.add("hide-section");
                }
            }
        }

        function switchView(tabId) {
            document.querySelectorAll(".race-section").forEach(s => s.classList.add("hide-section"));
            const activeSection = document.getElementById(tabId);
            if (activeSection) activeSection.classList.remove("hide-section");

            document.querySelectorAll(".race-pool").forEach(p => p.classList.add("hide-section"));
            if (tabId === "main-race") {
                const poolMain = document.getElementById("pool-main");
                if(poolMain) poolMain.classList.remove("hide-section");
            } else if (tabId === "sprint-race") {
                const poolSprint = document.getElementById("pool-sprint");
                if(poolSprint) poolSprint.classList.remove("hide-section");
            } else if (tabId === "season-drivers") {
                const poolSDrivers = document.getElementById("pool-season-drivers");
                if(poolSDrivers) poolSDrivers.classList.remove("hide-section");
            } else if (tabId === "season-teams") {
                const poolSTeams = document.getElementById("pool-season-teams");
                if(poolSTeams) poolSTeams.classList.remove("hide-section");
            }

            document.querySelectorAll(".btn-tab").forEach(b => b.classList.remove("active"));
            if(event) event.currentTarget.classList.add("active");

            const dlText = document.getElementById("deadline-text");
            if(dlText) {
                if (tabId.startsWith("season")) {
                    dlText.innerText = "Deadline Seizoen: 13 maart 2026 - 07:00 (Start Q1)";
                } else {
                    dlText.innerText = "Deadline: Check kalender";
                }
            }
        }

        // SIMPELE DIRECTE AANPAK - lees ALLE selects uit en filter op class
        function getValuesFromSlots(desktopPrefix, count, mobilePrefix) {
            let result = [];

            console.log(`\n=== getValuesFromSlots called for ${desktopPrefix} ===`);

            // Bepaal welke class we zoeken
            let targetClass = '';
            if (mobilePrefix === 'mobile-race-pos') {
                targetClass = 'mobile-select-main';
            } else if (mobilePrefix === 'mobile-sprint-pos') {
                targetClass = 'mobile-select-sprint';
            } else if (mobilePrefix === 'mobile-sdriver-pos') {
                targetClass = 'mobile-select-sdrivers';
            } else if (mobilePrefix === 'mobile-steam-pos') {
                targetClass = 'mobile-select-steams';
            }

            console.log(`  Looking for class: "${targetClass}"`);

            // Haal ALLE selects op met deze class
            const selects = document.querySelectorAll(`select.${targetClass}`);
            console.log(`  Found ${selects.length} select elements with class "${targetClass}"`);

            // Loop door alle selects en lees hun waarden uit
            selects.forEach((select, index) => {
                const value = select.value ? select.value.trim() : "";
                console.log(`  Select ${index + 1}: ID="${select.id}" Value="${value}"`);
                result.push(value);
            });

            // Als we via class niet genoeg hebben, probeer ook desktop drop zones
            if (result.length === 0 || result.every(v => v === "")) {
                console.log(`  Mobile selects empty, trying desktop dropzones...`);

                for (let i = 1; i <= count; i++) {
                    let startnr = "";
                    const dropZoneId = `${desktopPrefix}${i}`;

                    // Zoek dropzone via querySelectorAll
                    const allDivs = document.querySelectorAll('div.drop-target');
                    let dropZone = null;

                    allDivs.forEach(div => {
                        if (div.id === dropZoneId) {
                            dropZone = div;
                        }
                    });

                    if (dropZone && dropZone.children.length > 0) {
                        const card = dropZone.children[0];
                        if (card.classList && (card.classList.contains('driver-card') || card.classList.contains('team-card'))) {
                            if (card.hasAttribute('data-id')) {
                                startnr = card.getAttribute('data-id');
                            } else if (card.id && card.id.includes('-c-')) {
                                const match = card.id.match(/-c-(\d+)/);
                                if (match && match[1]) startnr = match[1];
                            } else {
                                const numberSpan = card.querySelector('.dr-number');
                                if (numberSpan) startnr = numberSpan.innerText.trim();
                            }
                        }
                    }

                    if (i <= result.length) {
                        result[i - 1] = startnr;
                    } else {
                        result.push(startnr);
                    }
                }
            }

            const finalResult = result.join(",");
            console.log(`\n✓✓✓ FINAL RESULT for ${desktopPrefix}: "${finalResult}" ✓✓✓\n`);
            return finalResult;
        }

        // DEBUG FUNCTIE - Roep deze aan in de browser console: debugDropZones()
        function debugDropZones() {
            console.log("=== DEBUG: Searching for ALL selects in the page ===");
            const allSelects = document.querySelectorAll('select');
            console.log(`Found ${allSelects.length} select elements:`);

            // Filter alleen race-related selects
            const raceSelects = [];
            allSelects.forEach((select, index) => {
                const id = select.id || '(no id)';
                const visible = select.offsetParent !== null;
                const value = select.value || '(empty)';

                console.log(`  ${index + 1}. ID: "${id}" | Value: "${value}" | Visible: ${visible} | Classes: "${select.className}"`);

                // Verzamel race selects
                if (id.includes('race-pos') || id.includes('mobile-race')) {
                    raceSelects.push({ id, value, visible });
                }
            });

            console.log("\n=== RACE SELECTS FOUND ===");
            raceSelects.forEach(s => {
                console.log(`  ID: "${s.id}" | Value: "${s.value}" | Visible: ${s.visible}`);
            });

            console.log("\n=== TESTING getElementById ===");
            for (let i = 1; i <= 3; i++) {
                const testId = `mobile-race-pos${i}`;
                const elem = document.getElementById(testId);
