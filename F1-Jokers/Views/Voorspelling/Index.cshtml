@model F1Jokers.Models.VoorspellingViewModel
@inject F1Jokers.Data.AppDbContext DbContext

@{
    var gesorteerdeCoureurs = Model.Coureurs?
        .OrderBy(c => c.Team != null ? c.Team.Teamnaam : "ZZZ")
        .ThenBy(c => c.Startnr)
        .ToList();

    var gesorteerdeTeams = gesorteerdeCoureurs?
        .Where(c => c.Team != null)
        .GroupBy(c => c.Team.Teamnaam)
        .Select(g => g.First())
        .OrderBy(c => c.Team.Teamnaam)
        .ToList();

    // --- DEADLINE CONTROLE ---
    bool isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Beheerder");

    bool raceLocked = Model.HuidigeKalenderItem != null && DateTime.Now > Model.HuidigeKalenderItem.Deadline && !isAdmin;

    var seizoenItem = DbContext.Kalender.FirstOrDefault(k => k.RaceID.StartsWith("Seizoen"));
    bool seasonLocked = seizoenItem != null && DateTime.Now > seizoenItem.Deadline && !isAdmin;

    // --- PUNTEN LOGICA ---
    bool isRaceVerwerkt = Model.HuidigeKalenderItem?.IsVerwerkt ?? false;

    string mainId = Model.HuidigeKalenderItem?.RaceID ?? "";
    string sprintId = mainId + "S";
    var sprintItem = DbContext.Kalender.FirstOrDefault(k => k.RaceID == sprintId);
    bool isSprintVerwerkt = sprintItem?.IsVerwerkt ?? false;

    bool isSeasonVerwerkt = seizoenItem?.IsVerwerkt ?? false;

    int raceTotaal = isRaceVerwerkt && Model.BestaandeVoorspellingen != null
        ? Model.BestaandeVoorspellingen.Where(v => v.RaceID == mainId).Sum(v => v.BehaaldePunten) : 0;

    int sprintTotaal = isSprintVerwerkt && Model.BestaandeVoorspellingen != null
            ? Model.BestaandeVoorspellingen.Where(v => v.RaceID == sprintId).Sum(v => v.BehaaldePunten) : 0;

    int seizoenTotaal = isSeasonVerwerkt && Model.BestaandeVoorspellingen != null
            ? Model.BestaandeVoorspellingen.Where(v => v.RaceID == seizoenItem.RaceID).Sum(v => v.BehaaldePunten) : 0;

    // Helpers
    int GetPunten(string type)
    {
        var v = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == type);
        return v != null ? v.BehaaldePunten : 0;
    }

    string GetPuntenTextColor(int punten)
    {
        return punten > 0 ? "text-success" : "text-danger";
    }

    F1Jokers.Models.Coureur GetCoureur(int? startNr)
    {
        return startNr.HasValue ? gesorteerdeCoureurs?.FirstOrDefault(c => c.Startnr == startNr.Value) : null;
    }

    F1Jokers.Models.Team GetTeam(int? teamId)
    {
        return teamId.HasValue ? gesorteerdeTeams?.FirstOrDefault(c => c.Team?.TeamId == teamId.Value)?.Team : null;
    }
}

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="container py-5">
        <div class="text-center p-5 bg-dark border border-secondary rounded shadow" style="border-top: 5px solid var(--f1-red) !important;">
            <i class="bi bi-lock-fill text-danger display-1 mb-4"></i>
            <h1 class="text-white h2 fw-bold">TOEGANG GEWEIGERD</h1>
            <p class="text-light opacity-75 mb-4">Je moet ingelogd zijn om deel te nemen aan de F1-Jokers poule en voorspellingen te doen.</p>

            <a asp-controller="Account" asp-action="Inloggen" class="btn btn-danger btn-lg px-5 fw-bold shadow">
                <i class="bi bi-box-arrow-in-right me-2"></i> INLOGGEN
            </a>
        </div>
    </div>
}
else
{
    <section class="race-info text-center mb-4">
        <div class="mb-4">
            <form method="get" action="/Voorspelling/Index">

                <label for="raceIdSelector" class="visually-hidden">Kies een Grand Prix</label>
                <select id="raceIdSelector" name="raceId" class="form-select bg-dark text-white border-secondary w-auto d-inline-block" onchange="this.form.submit()">
                    @if (Model.VolledigeKalender != null)
                    {
                        foreach (var item in Model.VolledigeKalender)
                        {
                            <option value="@item.RaceID" selected="@(Model.HuidigeKalenderItem != null && item.RaceID == Model.HuidigeKalenderItem.RaceID)">@item.Racenaam</option>
                        }
                    }
                </select>
            </form>
        </div>

        <div class="race-tabs d-flex flex-wrap justify-content-center gap-2 mb-3">
            <button type="button" class="btn-tab active rounded" onclick="switchView('main-race')">Hoofdrace</button>
            @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
            {
                <button type="button" class="btn-tab rounded" onclick="switchView('sprint-race')">Sprintrace</button>
            }
            <button type="button" class="btn-tab btn-season rounded" onclick="switchView('season-drivers')">Seizoen Coureurs</button>
            <button type="button" class="btn-tab btn-season rounded" onclick="switchView('season-teams')">Seizoen Teams</button>
        </div>

        <div class="mb-4 d-none d-lg-block">
            <button type="button" id="btn-toggle-ui" class="btn btn-info fw-bold" onclick="toggleAccessibilityMode()">
                <i class="bi bi-universal-access"></i> Wissel naar Toegankelijk Voorspellen (Dropdowns)
            </button>
        </div>

        <div class="deadline-container mb-3">
            <div id="deadline-status" class="deadline-badge d-inline-block p-2 border border-danger text-danger fw-bold">
                <i class="bi bi-clock-fill"></i>
                <span id="deadline-text">
                    @(Model.HuidigeKalenderItem != null ? "Deadline: " + Model.HuidigeKalenderItem.Deadline.ToString("dd MMMM yyyy - HH:mm", new System.Globalization.CultureInfo("nl-NL")) : "Geen data beschikbaar")
                </span>
            </div>
        </div>
    </section>

    <div id="voorspel-container" class="prediction-container d-flex justify-content-center gap-4 responsive-layout">

        <section class="column desktop-only" id="selection-pool" style="width: 420px; max-width: 100%;">
            <h2 class="column-title border-bottom border-danger pb-2 mb-3">Keuzelijst</h2>

            <div class="scrollable-pool">
                <ul class="driver-list mb-4 race-pool list-unstyled" id="pool-main" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 100px;">
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var coureur in gesorteerdeCoureurs)
                        {
                            <li class="driver-card border border-secondary p-2 mb-2 d-flex align-items-center"
                                draggable="@(raceLocked ? "false" : "true")"
                                ondragstart="@(raceLocked ? "" : "drag(event)")"
                                id="main-c-@coureur.Startnr" data-id="@coureur.Startnr">
                                <div style="width: 230px;">
                                    <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; width: 25px;">@coureur.Startnr</span>
                                    <span class="dr-name text-white fw-bold">@coureur.Voornaam @coureur.Achternaam</span>
                                </div>
                                <span class="dr-team small text-secondary d-none d-sm-block text-nowrap">@(coureur.Team != null ? coureur.Team.Teamnaam : "")</span>
                            </li>
                        }
                    }
                </ul>

                @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
                {
                    <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-sprint" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 100px;">
                        @if (gesorteerdeCoureurs != null)
                        {
                            foreach (var coureur in gesorteerdeCoureurs)
                            {
                                <li class="driver-card border border-secondary p-2 mb-2 d-flex align-items-center"
                                    draggable="@(raceLocked ? "false" : "true")"
                                    ondragstart="@(raceLocked ? "" : "drag(event)")"
                                    id="sprint-c-@coureur.Startnr" data-id="@coureur.Startnr">
                                    <div style="width: 230px;">
                                        <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; width: 25px;">@coureur.Startnr</span>
                                        <span class="dr-name text-white fw-bold">@coureur.Voornaam @coureur.Achternaam</span>
                                    </div>
                                    <span class="dr-team small text-secondary d-none d-sm-block text-nowrap">@(coureur.Team != null ? coureur.Team.Teamnaam : "")</span>
                                </li>
                            }
                        }
                    </ul>
                }

                <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-season-drivers" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 100px;">
                    @if (gesorteerdeCoureurs != null)
                    {
                        foreach (var coureur in gesorteerdeCoureurs)
                        {
                            <li class="driver-card border border-secondary p-2 mb-2 d-flex align-items-center"
                                draggable="@(seasonLocked ? "false" : "true")"
                                ondragstart="@(seasonLocked ? "" : "drag(event)")"
                                id="sdriver-c-@coureur.Startnr" data-id="@coureur.Startnr">
                                <div style="width: 230px;">
                                    <span class="dr-number text-danger fw-bold me-3" style="display: inline-block; width: 25px;">@coureur.Startnr</span>
                                    <span class="dr-name text-white fw-bold">@coureur.Voornaam @coureur.Achternaam</span>
                                </div>
                                <span class="dr-team small text-secondary d-none d-sm-block text-nowrap">@(coureur.Team != null ? coureur.Team.Teamnaam : "")</span>
                            </li>
                        }
                    }
                </ul>

                <ul class="driver-list mb-4 race-pool hide-section list-unstyled" id="pool-season-teams" ondrop="drop(event)" ondragover="allowDrop(event)" style="min-height: 100px;">
                    @if (gesorteerdeTeams != null)
                    {
                        foreach (var teamRep in gesorteerdeTeams)
                        {
                            <li class="team-card border border-secondary p-2 mb-2 d-flex align-items-center"
                                draggable="@(seasonLocked ? "false" : "true")"
                                ondragstart="@(seasonLocked ? "" : "drag(event)")"
                                id="team-c-@teamRep.Team.TeamId" data-id="@teamRep.Team.TeamId">
                                <div style="width: 230px;">
                                    <span class="dr-name text-white fw-bold">@teamRep.Team.Teamnaam</span>
                                </div>
                                <span class="t-pu small text-secondary d-none d-sm-block text-nowrap">@teamRep.Team.Powerunit</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </section>

        <!-- ================= HOOFDRACE SECTIE ================= -->
        <section class="column race-section" id="main-race" style="width: @(raceLocked ? "530px" : "420px"); max-width: 100%;">
            @if (raceLocked)
            {
                <div class="card bg-dark border-secondary p-3 mb-4 rounded-1 shadow-sm">
                    <h5 class="text-white fw-bold text-uppercase border-bottom border-danger pb-2 mb-3">Top 10 (Race)</h5>
                    @for (int i = 1; i <= 10; i++)
                    {
                        var v = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == $"RacePos{i}");
                        var c = GetCoureur(v?.StartNr);

                        <div class="d-flex align-items-center mb-2">
                            <div class="bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                            <div class="border border-secondary flex-grow-1 px-3 py-2 d-flex justify-content-between align-items-center rounded-1 ms-2 @(isRaceVerwerkt ? "me-2" : "")" style="background-color: rgba(0,0,0,0.2); height: 40px;">
                                @if (c != null)
                                {
                                    <div>
                                        <span class="text-danger fw-bold me-3" style="width: 20px; display: inline-block;">@c.Startnr</span>
                                        <span class="text-white fw-bold">@c.Voornaam @c.Achternaam</span>
                                    </div>
                                    <span class="text-secondary small d-none d-sm-block">@(c.Team?.Teamnaam ?? "Onbekend")</span>
                                }
                                else
                                {

                                    <span class="text-muted small">-</span>
                                }
                            </div>
                            @if (isRaceVerwerkt)
                            {
                                int pts = v?.BehaaldePunten ?? 0;
                                <div class="@GetPuntenTextColor(pts) bg-transparent fw-bold fs-5 d-flex justify-content-center align-items-center rounded-1 ms-2" style="width: 45px; height: 40px; min-width: 45px;">@pts</div>
                            }
                        </div>
                    }
                </div>

                <div class="card bg-dark border-secondary p-3 rounded-1 mb-4 shadow-sm">
                    <h5 class="text-white fw-bold text-uppercase border-bottom border-danger pb-2 mb-3">Race Extra</h5>
                    @{
                        var pole = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == "RacePole");
                        var cPole = GetCoureur(pole?.StartNr);
                        var fastest = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == "SnelsteRonde");
                        var cFastest = GetCoureur(fastest?.StartNr);
                    }
                    <div class="mb-3">
                        <label class="text-danger fw-bold small mb-1">Pole Position</label>
                        <div class="d-flex align-items-center">
                            <div class="border border-secondary flex-grow-1 p-2 rounded-1 d-flex align-items-center @(isRaceVerwerkt ? "me-2" : "")" style="background-color: rgba(0,0,0,0.2); height: 40px;">
                                @if (cPole != null)
                                {
                                    <span class="text-white">@cPole.Startnr | @cPole.Voornaam @cPole.Achternaam <span class="text-secondary mx-1">|</span> @(cPole.Team?.Teamnaam)</span>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </div>
                            @if (isRaceVerwerkt)
                            {
                                int pts = pole?.BehaaldePunten ?? 0;
                                <div class="@GetPuntenTextColor(pts) bg-transparent fw-bold fs-5 d-flex justify-content-center align-items-center rounded-1 ms-2" style="width: 45px; height: 40px; min-width: 45px;">@pts</div>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="text-danger fw-bold small mb-1">Snelste Ronde</label>
                        <div class="d-flex align-items-center">
                            <div class="border border-secondary flex-grow-1 p-2 rounded-1 d-flex align-items-center @(isRaceVerwerkt ? "me-2" : "")" style="background-color: rgba(0,0,0,0.2); height: 40px;">
                                @if (cFastest != null)
                                {
                                    <span class="text-white">@cFastest.Startnr | @cFastest.Voornaam @cFastest.Achternaam <span class="text-secondary mx-1">|</span> @(cFastest.Team?.Teamnaam)</span>
                                }
                                else
                                {

                                    <span class="text-muted">-</span>
                                }
                            </div>
                            @if (isRaceVerwerkt)
                            {
                                int pts = fastest?.BehaaldePunten ?? 0;
                                <div class="@GetPuntenTextColor(pts) bg-transparent fw-bold fs-5 d-flex justify-content-center align-items-center rounded-1 ms-2" style="width: 45px; height: 40px; min-width: 45px;">@pts</div>
                            }
                        </div>
                    </div>
                </div>

                @if (isRaceVerwerkt)
                {
                    <div class="border border-secondary rounded-1 p-3 text-center mt-4 mb-2" style="background-color: rgba(255, 255, 255, 0.05);">
                        <span class="text-light opacity-75 text-uppercase fw-bold small d-block mb-1">Totaal Hoofdrace</span>
                        <span class="@GetPuntenTextColor(raceTotaal) fw-bold fs-3">@raceTotaal Punten</span>
                    </div>
                }
            }
            else
            {
                <h2 class="column-title border-bottom border-danger pb-2 mb-3">Top 10 (Race)</h2>
                <div class="drop-zones mb-4">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <div class="slot d-flex mb-2 align-items-center">
                            <div class="pos-num bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                            <div class="drop-target border border-secondary flex-grow-1 ms-2 desktop-only rounded-1 px-3 d-flex align-items-center" id="race-pos@(i)" ondrop="drop(event)" ondragover="allowDrop(event)" style="background-color: rgba(0,0,0,0.2); height: 40px;">...</div>
                            <label for="mobile-race-pos@(i)" class="visually-hidden">Positie @i</label>
                            <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-main" id="mobile-race-pos@(i)" style="height: 40px;">
                                <option value="">Kies coureur...</option>
                                @if (gesorteerdeCoureurs != null)
                                {
                                    foreach (var c in gesorteerdeCoureurs)
                                    {
                                        <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="bonus-section mt-4 p-3 border border-secondary rounded">
                    <h3 class="column-title h5 text-white">Race Extra</h3>
                    <div class="mb-3">
                        <label for="bonus-pole" class="text-danger small fw-bold d-block mb-1">Pole Position</label>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="bonus-pole" style="height: 40px;">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-0">
                        <label for="bonus-fastest" class="text-danger small fw-bold d-block mb-1">Snelste Ronde</label>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="bonus-fastest" style="height: 40px;">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            }
        </section>

        <!-- ================= SPRINTRACE SECTIE ================= -->
        @if (Model.HuidigeKalenderItem != null && Model.HuidigeKalenderItem.HasSprintRace)
        {
            <section class="column race-section hide-section" id="sprint-race" style="width: @(raceLocked ? "530px" : "420px"); max-width: 100%;">
                @if (raceLocked)
                {
                    <div class="card bg-dark border-secondary p-3 mb-4 rounded-1 shadow-sm">
                        <h5 class="text-white fw-bold text-uppercase border-bottom border-danger pb-2 mb-3">Top 5 (Sprint)</h5>
                        @for (int i = 1; i <= 5; i++)
                        {
                            var v = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == $"SprintPos{i}");
                            var c = GetCoureur(v?.StartNr);

                            <div class="d-flex align-items-center mb-2">
                                <div class="bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                                <div class="border border-secondary flex-grow-1 px-3 py-2 d-flex justify-content-between align-items-center rounded-1 ms-2 @(isSprintVerwerkt ? "me-2" : "")" style="background-color: rgba(0,0,0,0.2); height: 40px;">
                                    @if (c != null)
                                    {
                                        <div>
                                            <span class="text-danger fw-bold me-3" style="width: 20px; display: inline-block;">@c.Startnr</span>
                                            <span class="text-white fw-bold">@c.Voornaam @c.Achternaam</span>
                                        </div>
                                        <span class="text-secondary small d-none d-sm-block">@(c.Team?.Teamnaam ?? "Onbekend")</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </div>
                                @if (isSprintVerwerkt)
                                {
                                    int pts = v?.BehaaldePunten ?? 0;
                                    <div class="@GetPuntenTextColor(pts) bg-transparent fw-bold fs-5 d-flex justify-content-center align-items-center rounded-1 ms-2" style="width: 45px; height: 40px; min-width: 45px;">@pts</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="card bg-dark border-secondary p-3 rounded-1 mb-4 shadow-sm">
                        <h5 class="text-white fw-bold text-uppercase border-bottom border-danger pb-2 mb-3">Sprint Extra</h5>
                        @{
                            var sprintPole = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == "SprintPole");
                            var cSprintPole = GetCoureur(sprintPole?.StartNr);
                        }
                        <div>
                            <label class="text-danger fw-bold small mb-1">Sprint Pole Position</label>
                            <div class="d-flex align-items-center">
                                <div class="border border-secondary flex-grow-1 p-2 rounded-1 d-flex align-items-center @(isSprintVerwerkt ? "me-2" : "")" style="background-color: rgba(0,0,0,0.2); height: 40px;">
                                    @if (cSprintPole != null)
                                    {
                                        <span class="text-white">@cSprintPole.Startnr | @cSprintPole.Voornaam @cSprintPole.Achternaam <span class="text-secondary mx-1">|</span> @(cSprintPole.Team?.Teamnaam)</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">-</span>
                                    }
                                </div>
                                @if (isSprintVerwerkt)
                                {
                                    int pts = sprintPole?.BehaaldePunten ?? 0;
                                    <div class="@GetPuntenTextColor(pts) bg-transparent fw-bold fs-5 d-flex justify-content-center align-items-center rounded-1 ms-2" style="width: 45px; height: 40px; min-width: 45px;">@pts</div>
                                }
                            </div>
                        </div>
                    </div>

                    @if (isSprintVerwerkt)
                    {
                        <div class="border border-secondary rounded-1 p-3 text-center mt-4 mb-2" style="background-color: rgba(255, 255, 255, 0.05);">
                            <span class="text-light opacity-75 text-uppercase fw-bold small d-block mb-1">Totaal Sprintrace</span>
                            <span class="@GetPuntenTextColor(sprintTotaal) fw-bold fs-3">@sprintTotaal Punten</span>
                        </div>
                    }
                }
                else
                {
                    <h2 class="column-title border-bottom border-danger pb-2 mb-3">Top 5 (Sprint)</h2>
                    <div class="drop-zones mb-4">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <div class="slot d-flex mb-2 align-items-center">
                                <div class="pos-num bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                                <div class="drop-target border border-secondary flex-grow-1 ms-2 desktop-only rounded-1 px-3 d-flex align-items-center" id="sprint-pos@(i)" ondrop="drop(event)" ondragover="allowDrop(event)" style="background-color: rgba(0,0,0,0.2); height: 40px;">...</div>
                                <label for="mobile-sprint-pos@(i)" class="visually-hidden">Sprint Positie @i</label>
                                <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-sprint" id="mobile-sprint-pos@(i)" style="height: 40px;">
                                    <option value="">Kies coureur...</option>
                                    @if (gesorteerdeCoureurs != null)
                                    {
                                        foreach (var c in gesorteerdeCoureurs)
                                        {
                                            <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    <div class="bonus-section mt-4 p-3 border border-secondary rounded">
                        <h3 class="column-title h5 text-white">Sprint Extra</h3>
                        <div class="mb-0">
                            <label for="bonus-sprint-pole" class="text-danger small fw-bold d-block mb-1">Sprint Pole</label>
                            <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="bonus-sprint-pole" style="height: 40px;">
