                        <span class="@GetPuntenTextColor(seizoenTotaal) fw-bold fs-3">@seizoenTotaal Punten</span>
                    </div>
                }
            }
            else
            {
                <h2 class="column-title border-bottom border-danger pb-2 mb-3">Eindstand Coureurs (Top 22)</h2>
                <div class="drop-zones mb-4">
                    @for (int i = 1; i <= 22; i++)
                    {
                        <div class="slot d-flex mb-2 align-items-center">
                            <div class="pos-num bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                            <div class="drop-target border border-secondary flex-grow-1 ms-2 desktop-only rounded-1 px-3 d-flex align-items-center" id="sdriver-pos@(i)" ondrop="drop(event)" ondragover="allowDrop(event)" style="background-color: rgba(0,0,0,0.2); height: 40px;">...</div>
                            <label for="mobile-sdriver-pos@(i)" class="visually-hidden">Seizoen Coureur Positie @i</label>
                            <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-sdrivers" id="mobile-sdriver-pos@(i)" style="height: 40px;">
                                <option value="">Kies coureur...</option>
                                @if (gesorteerdeCoureurs != null)
                                {
                                    foreach (var c in gesorteerdeCoureurs)
                                    {
                                        <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- ================= SEIZOEN TEAMS SECTIE ================= -->
        <section class="column race-section hide-section" id="season-teams" style="width: @(seasonLocked ? "530px" : "420px"); max-width: 100%;">
            @if (seasonLocked)
            {
                <div class="card bg-dark border-secondary p-3 mb-4 rounded-1 shadow-sm">
                    <h5 class="text-white fw-bold text-uppercase border-bottom border-danger pb-2 mb-3">Eindstand Teams</h5>
                    @for (int i = 1; i <= 11; i++)
                    {
                        var vTeam = Model.BestaandeVoorspellingen?.FirstOrDefault(x => x.TypeVoorspelling == $"SeizoenTPos{i}");
                        var t = GetTeam(vTeam?.TeamId);

                        if (t != null || i <= 10)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <div class="bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                                <div class="border border-secondary flex-grow-1 px-3 py-2 d-flex justify-content-between align-items-center rounded-1 ms-2 @(isSeasonVerwerkt ? "me-2" : "")" style="background-color: rgba(0,0,0,0.2); height: 40px;">
                                    @if (t != null)
                                    {
                                        <span class="text-white fw-bold">@t.Teamnaam</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </div>
                                @if (isSeasonVerwerkt)
                                {
                                    int pts = vTeam?.BehaaldePunten ?? 0;
                                    <div class="@GetPuntenTextColor(pts) bg-transparent fw-bold fs-5 d-flex justify-content-center align-items-center rounded-1 ms-2" style="width: 45px; height: 40px; min-width: 45px;">@pts</div>
                                }
                            </div>
                        }
                    }
                </div>

                @if (isSeasonVerwerkt)
                {
                    <div class="border border-secondary rounded-1 p-3 text-center mt-4 mb-2" style="background-color: rgba(255, 255, 255, 0.05);">
                        <span class="text-light opacity-75 text-uppercase fw-bold small d-block mb-1">Totaal Seizoensbonus</span>
                        <span class="@GetPuntenTextColor(seizoenTotaal) fw-bold fs-3">@seizoenTotaal Punten</span>
                    </div>
                }
            }
            else
            {
                <h2 class="column-title border-bottom border-danger pb-2 mb-3">Eindstand Teams (Top 11)</h2>
                <div class="drop-zones mb-4">
                    @for (int i = 1; i <= 11; i++)
                    {
                        <div class="slot d-flex mb-2 align-items-center">
                            <div class="pos-num bg-danger text-white fw-bold d-flex justify-content-center align-items-center rounded-1" style="width: 40px; height: 40px; min-width: 40px;">@i</div>
                            <div class="drop-target border border-secondary flex-grow-1 ms-2 desktop-only rounded-1 px-3 d-flex align-items-center" id="steam-pos@(i)" ondrop="drop(event)" ondragover="allowDrop(event)" style="background-color: rgba(0,0,0,0.2); height: 40px;">...</div>
                            <label for="mobile-steam-pos@(i)" class="visually-hidden">Seizoen Team Positie @i</label>
                            <select class="form-select bg-dark text-white border-secondary flex-grow-1 ms-2 mobile-only mobile-select-steams" id="mobile-steam-pos@(i)" style="height: 40px;">
                                <option value="">Kies team...</option>
                                @if (gesorteerdeTeams != null)
                                {
                                    foreach (var teamRep in gesorteerdeTeams)
                                    {
                                        <option value="@teamRep.Team.TeamId">@teamRep.Team.Teamnaam &nbsp;&nbsp;|&nbsp;&nbsp; @teamRep.Team.Powerunit</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="bonus-section mt-4 p-3 border border-secondary rounded">
                    <h3 class="column-title h5 text-white">Seizoen Extra</h3>
                    <div class="mb-3">
                        <label for="season-most-wins" class="text-danger small fw-bold d-block mb-1">Meeste Race Overwinningen</label>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="season-most-wins" style="height: 40px;">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="season-most-sprint-wins" class="text-danger small fw-bold d-block mb-1">Meeste Sprint Overwinningen</label>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="season-most-sprint-wins" style="height: 40px;">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="season-most-poles" class="text-danger small fw-bold d-block mb-1">Meeste Race Poles</label>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="season-most-poles" style="height: 40px;">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-0">
                        <label for="season-most-sprint-poles" class="text-danger small fw-bold d-block mb-1">Meeste Sprint Poles</label>
                        <select class="form-select bg-dark text-white border-secondary flex-grow-1" id="season-most-sprint-poles" style="height: 40px;">
                            <option value="">Kies coureur...</option>
                            @if (gesorteerdeCoureurs != null)
                            {
                                foreach (var c in gesorteerdeCoureurs)
                                {
                                    <option value="@c.Startnr">@c.Startnr &nbsp;&nbsp;|&nbsp;&nbsp; @c.Voornaam @c.Achternaam &nbsp;&nbsp;|&nbsp;&nbsp; @(c.Team != null ? c.Team.Teamnaam : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            }
        </section>

    </div>

    <div id="action-area" class="text-center mt-5 mb-5">
        <button id="btn-opslaan" type="button" class="btn btn-lg btn-danger px-5 py-3 fw-bold shadow" onclick="verstuurVoorspelling()">
            VOORSPELLING OPSLAAN
        </button>

        <div id="alert-gesloten" class="alert alert-warning text-center fw-bold border-warning" style="display: none; max-width: 800px; margin: 0 auto;">
            <i class="bi bi-lock-fill"></i> DE DEADLINE IS VERSTREKEN. JE KUNT JE VOORSPELLINGEN ALLEEN NOG BEKIJKEN.
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/voorspellen.js" asp-append-version="true"></script>
    <script>
        window.isRaceLocked = @(raceLocked.ToString().ToLower());
        window.isSeasonLocked = @(seasonLocked.ToString().ToLower());

        const origineleSwitchView = window.switchView;
        window.switchView = function (tabId) {
        if (typeof origineleSwitchView === "function") {
        origineleSwitchView(tabId);
        }

        let isLocked = false;
        if (tabId === 'season-drivers' || tabId === 'season-teams') {
        isLocked = window.isSeasonLocked;
        } else {
        isLocked = window.isRaceLocked;
        }

        const btnOpslaan = document.getElementById('btn-opslaan');
        const alertGesloten = document.getElementById('alert-gesloten');
        const selectionPool = document.getElementById('selection-pool');

        if (btnOpslaan && alertGesloten) {
        if (isLocked) {
        btnOpslaan.style.display = 'none';
        alertGesloten.style.display = 'block';
        if (selectionPool) selectionPool.style.display = 'none';
        } else {
        btnOpslaan.style.display = 'inline-block';
        alertGesloten.style.display = 'none';
        if (selectionPool) selectionPool.style.display = '';
        }
        }
        };

        document.addEventListener("DOMContentLoaded", function () {
        window.switchView('main-race');

        const dbData = @Html.Raw(Json.Serialize(Model.BestaandeVoorspellingen));

        if (!dbData || dbData.length === 0) return;

        dbData.forEach(v => {
        let typeV = (v.typeVoorspelling || v.TypeVoorspelling || "").trim();

        let dataId = String(v.startNr ?? v.StartNr ?? v.startnr ?? v.teamId ?? v.TeamId ?? "").trim();

        if (!typeV || dataId === "") return;

        const bonusMap = {
        "RacePole": "bonus-pole", "SnelsteRonde": "bonus-fastest", "SprintPole": "bonus-sprint-pole",
        "MeesteRaceWinst": "season-most-wins", "MeesteSprintWinst": "season-most-sprint-wins",
        "MeesteRacePoles": "season-most-poles", "MeesteSprintPoles": "season-most-sprint-poles"
        };
        if (bonusMap[typeV]) {
        const el = document.getElementById(bonusMap[typeV]);
        if (el) el.value = dataId;
        return;
        }

        let zoneId = "", poolId = "", mobId = "";
        if (typeV.includes("RacePos")) {
        let n = typeV.replace("RacePos", ""); zoneId = "race-pos" + n; poolId = "pool-main"; mobId = "mobile-race-pos" + n;
        }
        else if (typeV.includes("SprintPos")) {
        let n = typeV.replace("SprintPos", ""); zoneId = "sprint-pos" + n; poolId = "pool-sprint"; mobId = "mobile-sprint-pos" + n;
        }
        else if (typeV.includes("SeizoenCPos")) {
        let n = typeV.replace("SeizoenCPos", ""); zoneId = "sdriver-pos" + n; poolId = "pool-season-drivers"; mobId = "mobile-sdriver-pos" + n;
        }
        else if (typeV.includes("SeizoenTPos")) {
        let n = typeV.replace("SeizoenTPos", ""); zoneId = "steam-pos" + n; poolId = "pool-season-teams"; mobId = "mobile-steam-pos" + n;
        }

        if (zoneId && poolId) {
        const dropZone = document.getElementById(zoneId);
        const card = document.querySelector("#" + poolId + " li[data-id='" + dataId + "']");

        if (dropZone && card) {
        const clone = card.cloneNode(true);
        clone.id = "clone-" + card.id + "-target-" + dropZone.id;
        clone.setAttribute("ondragstart", "drag(event)");
        clone.setAttribute("data-id", dataId);

        clone.classList.remove("hide-section");

        dropZone.innerHTML = "";
        dropZone.appendChild(clone);
        card.classList.add("hide-section");
        }
        }
        if (mobId) {
        const el = document.getElementById(mobId);
        if (el) el.value = dataId;
        }
        });
        });
    </script>
}