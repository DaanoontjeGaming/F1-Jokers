@{
    var isLoginPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
                       ViewContext.RouteData.Values["action"]?.ToString() == "Inloggen";
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - F1 Jokers</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-dark text-white d-flex flex-column min-vh-100">

    @if (!isLoginPage)
    {
        <div class="header-nav-wrapper bg-dark border-bottom border-secondary sticky-top">
            <div class="container d-flex justify-content-between align-items-center p-2 p-md-3">
                
                <a href="/" class="logo-link">
                    <img src="~/images/F1Jokers.png" alt="F1 Jokers" class="app-logo" />
                </a>
                
                <nav class="main-navigation">
                    <div class="nav-container d-flex gap-md-4">
                        <a href="/" class="nav-item text-white text-decoration-none text-center">
                            <i class="bi bi-house-door-fill"></i> <span class="nav-text">Home</span>
                        </a>
                        <a href="/Voorspelling/Index" class="nav-item text-white text-decoration-none text-center">
                            <i class="bi bi-gear-fill"></i> <span class="nav-text">Voorspellen</span>
                        </a>
                        <a href="#" class="nav-item text-white text-decoration-none text-center">
                            <i class="bi bi-trophy"></i> <span class="nav-text">Poule</span>
                        </a>
                        <a href="#" class="nav-item text-white text-decoration-none text-center">
                            <i class="bi bi-flag"></i> <span class="nav-text">Uitslagen</span>
                        </a>
                        <a href="#" class="nav-item text-white text-decoration-none text-center">
                            <i class="bi bi-person-circle"></i> <span class="nav-text">Profiel</span>
                        </a>
                    </div>
                </nav>

                <div class="user-info text-end d-flex align-items-center">
                    <i class="bi bi-person-circle text-danger fs-4 me-2"></i>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-uppercase fw-bold text-white">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2 m-0">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    }
                    else
                    {
                        <span class="text-uppercase fw-bold text-white">GASTBEZOEKER</span>
                    }
                </div>

            </div>
        </div>
    }

    <main class="container flex-grow-1 mt-4">
        @RenderBody()
    </main>

    @if (!isLoginPage)
    {
        <footer class="mt-5 p-4 border-top border-secondary bg-dark text-center text-muted">
            <div class="container">
                <p class="small mb-0">&copy; @DateTime.Now.Year - F1 Jokers. Alle rechten voorbehouden.</p>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>