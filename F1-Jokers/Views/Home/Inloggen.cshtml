@model F1Jokers.Models.LoginViewModel

@{
    ViewData["Title"] = "Inloggen";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4 column">
            <h2 class="column-title">Inloggen</h2>
            
            <form asp-action="Inloggen" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="text-danger small fw-bold d-block mb-1"></label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="text-danger small fw-bold d-block mb-1"></label>
                    <input asp-for="Password" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn-tab active w-100">Race Start</button>
            </form>
        </div>
    </div>
</div>