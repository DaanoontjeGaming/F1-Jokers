@model F1Jokers.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<style>
    /* Subtiele, donkere F1-thema scrollbar voor de standenlijsten */
        .standings-scroll {
            max-height: 370px; /* Verlaagd van 420px naar 340px voor precies 11 items */
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 8px; /* Ruimte voor de scrollbar */
        }
    

        .standings-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .standings-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 4px;
        }

        .standings-scroll::-webkit-scrollbar-thumb {
            background: rgba(220, 53, 69, 0.4); /* Subtiel F1 Rood */
            border-radius: 4px;
        }

            .standings-scroll::-webkit-scrollbar-thumb:hover {
                background: rgba(220, 53, 69, 0.8); /* Iets feller rood bij hover */
            }
</style>

<div class="container py-4">
    <div class="text-center mb-5">
        <img src="~/images/F1Jokers.png" alt="F1 Jokers Logo" class="img-fluid mb-3" style="max-height: 80px;" onerror="this.style.display='none';" />
        <h1 class="display-4 text-danger fw-bold">Welkom bij F1-Jokers!</h1>
        <p class="text-light opacity-75">Hét platform waar je samen met vrienden de Formule 1 races kunt voorspellen.</p>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-lg-3 order-2 order-lg-1">
            <div class="px-2">
                <h6 class="text-white-50 text-uppercase fw-bold mb-3 border-bottom border-secondary pb-2" style="letter-spacing: 1px; font-size: 0.85rem;">WK Coureurs</h6>

                <div class="standings-scroll">
                    @foreach (var coureur in Model.CoureursStand)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <div class="d-flex align-items-center">
                                <span class="text-secondary fw-bold text-end me-3" style="width: 20px; font-size: 0.85rem;">@coureur.Positie</span>
                                <span class="text-light" style="font-size: 0.85rem;">@coureur.Naam</span>
                            </div>
                            <span class="text-danger fw-bold" style="font-size: 0.85rem;">@coureur.Punten</span>
                        </div>
                    }
                    @if (!Model.CoureursStand.Any())
                    {
                        <div class="text-muted small py-3">Geen data beschikbaar</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 order-1 order-lg-2">
            @if (Model.EerstvolgendeRace != null)
            {
                <div class="card bg-transparent border-secondary shadow-sm">
                    <div class="card-header border-secondary text-danger fw-bold text-center text-uppercase fs-5" style="background-color: rgba(0,0,0,0.4);">
                        <i class="bi bi-calendar-event me-2"></i> Eerstvolgende Race: @Model.EerstvolgendeRace.Racenaam
                    </div>
                    <div class="card-body text-center p-4" style="background-color: rgba(0,0,0,0.2);">
                        <p class="mb-1 text-white fw-bold">Racedatum: <span class="fw-normal text-light">@Model.EerstvolgendeRace.Datum.ToString("dd MMMM yyyy")</span></p>
                        <p class="mb-4 text-white fw-bold">Deadline voorspellen: <span class="text-warning">@Model.EerstvolgendeRace.Deadline.ToString("dd-MM-yyyy HH:mm")</span></p>

                        <div class="bg-white rounded p-2 mb-4 mx-auto d-inline-block" style="max-width: 400px;">
                            <img src="~/images/tracks/@(Model.EerstvolgendeRace.Racenaam.Replace(" ", "_")).png"
                                 alt="Circuit @Model.EerstvolgendeRace.Racenaam"
                                 class="img-fluid"
                                 onerror="this.src='https://cdn-icons-png.flaticon.com/512/1465/1465551.png'; this.style.filter='invert(1)';" />
                        </div>

                        <div class="d-block mt-2">
                            <a asp-controller="Voorspelling" asp-action="Index" class="btn btn-danger fw-bold px-4 py-2 text-uppercase shadow">
                                <i class="bi bi-gear-fill me-2"></i> Plaats je voorspelling
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-dark border-secondary text-center">
                    <i class="bi bi-flag-fill text-danger fs-3 d-block mb-2"></i>
                    <span class="fw-bold">Er staan momenteel geen races gepland.</span>
                </div>
            }
        </div>

        <div class="col-lg-3 order-3 order-lg-3">
            <div class="px-2">
                <h6 class="text-white-50 text-uppercase fw-bold mb-3 border-bottom border-secondary pb-2" style="letter-spacing: 1px; font-size: 0.85rem;">WK Teams</h6>

                <div class="standings-scroll">
                    @foreach (var team in Model.TeamsStand)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <div class="d-flex align-items-center">
                                <span class="text-secondary fw-bold text-end me-3" style="width: 20px; font-size: 0.85rem;">@team.Positie</span>
                                <span class="text-light" style="font-size: 0.85rem;">@team.Naam</span>
                            </div>
                            <span class="text-danger fw-bold" style="font-size: 0.85rem;">@team.Punten</span>
                        </div>
                    }
                    @if (!Model.TeamsStand.Any())
                    {
                        <div class="text-muted small py-3">Geen data beschikbaar</div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>